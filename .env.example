# Скопируйте этот файл в .env и вставьте свой ключ. Файл .env в git не попадает (.gitignore).
# Ключ: https://aistudio.google.com → Get API key → Create API key (бесплатный тариф достаточен).
GEMINI_API_KEY=

# Модель Gemini (необязательно). По умолчанию — gemini-3.5-flash.
# GEMINI_MODEL=gemini-3.5-flash

# Пауза между запросами к LLM в секундах (для бесплатного тарифа с низким лимитом запросов в минуту).
# REQCHECK_MIN_INTERVAL=0

# Допущения для оценки экономии (Приложение E отчёта).
# REQCHECK_RATE_KZT=5000
# REQCHECK_MANUAL_BASE_MIN=30
# REQCHECK_MANUAL_MIN_PER_REQ=6
# REQCHECK_CHECK_MIN_PER_FINDING=1.5
